<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ShopZone - Storefront</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f9; }
    nav { background: #1971c2; padding: 14px 24px; display: flex; gap: 20px; }
    nav a { color: #fff; text-decoration: none; font-weight: bold; }
    .container { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
    .card { background: #fff; border-radius: 8px; padding: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); display: flex; flex-direction: column; justify-content: space-between; }
    .card img { width: 100%; height: 140px; object-fit: cover; border-radius: 6px; }
    button { width: 100%; padding: 9px; background: #1971c2; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
    button:disabled { background: #adb5bd; cursor: not-allowed; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Storefront</a>
    <a href="/cart">Cart (<%= cartCount %>)</a>
    <a href="/orders">Successful Orders</a>
    <a href="/seller">Seller Master Panel</a>
  </nav>

  <div class="container">
    <h1>All Products</h1>
    <div class="grid">
      <% products.forEach(p => { %>
        <div class="card">
          <div>
            <img src="<%= p.image %>" alt="<%= p.name %>" />
            <h3><%= p.name %></h3>
            <p><%= p.description %></p>
            <p><strong>₹<%= p.price %></strong> • Stock: <%= p.stock %></p>
          </div>
          <form action="/cart/add/<%= p._id %>" method="POST">
            <button type="submit" <%= p.stock <= 0 ? "disabled" : "" %>>
              <%= p.stock > 0 ? "Add to Cart" : "Out of Stock" %>
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>