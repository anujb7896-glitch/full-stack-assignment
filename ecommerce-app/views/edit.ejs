<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit Product</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f9; }
    nav { background: #1971c2; padding: 14px 24px; display: flex; gap: 20px; }
    nav a { color: #fff; text-decoration: none; font-weight: bold; }
    .container { max-width: 540px; margin: 24px auto; background: #fff; padding: 24px; border-radius: 8px; }
    input, textarea { width: 100%; padding: 9px; margin: 6px 0 14px; box-sizing: border-box; }
    button { padding: 10px 18px; background: #1971c2; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Storefront</a>
    <a href="/cart">Cart (<%= cartCount %>)</a>
    <a href="/orders">Successful Orders</a>
    <a href="/seller">Seller Master Panel</a>
  </nav>

  <div class="container">
    <h1>Edit Product Details</h1>
    <form action="/seller/products/<%= product._id %>/edit" method="POST">
      <label>Product Name</label>
      <input type="text" name="name" value="<%= product.name %>" required />

      <label>Price (₹)</label>
      <input type="number" name="price" step="0.01" value="<%= product.price %>" required />

      <label>Stock</label>
      <input type="number" name="stock" value="<%= product.stock %>" required />

      <label>Image URL</label>
      <input type="text" name="image" value="<%= product.image %>" />

      <label>Description</label>
      <textarea name="description" rows="3" required><%= product.description %></textarea>

      <button type="submit">Save Changes</button>
      <a href="/seller" style="margin-left: 12px;">Cancel</a>
    </form>
  </div>
</body>
</html>