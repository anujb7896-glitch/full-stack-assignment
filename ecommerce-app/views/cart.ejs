<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Shopping Cart</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f9; }
    nav { background: #1971c2; padding: 14px 24px; display: flex; gap: 20px; }
    nav a { color: #fff; text-decoration: none; font-weight: bold; }
    .container { max-width: 800px; margin: 24px auto; background: #fff; padding: 20px; border-radius: 8px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
    th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
    .btn { display: inline-block; padding: 10px 16px; background: #2f9e44; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; }
  </style>
</head>
<body>
  <nav>
    <a href="/">Storefront</a>
    <a href="/cart">Cart (<%= cartCount %>)</a>
    <a href="/orders">Successful Orders</a>
    <a href="/seller">Seller Master Panel</a>
  </nav>

  <div class="container">
    <h1>Your Cart</h1>
    <% if (cart.length === 0) { %>
      <p>Your cart is empty. <a href="/">Continue shopping</a>.</p>
    <% } else { %>
      <table>
        <tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th><th>Action</th></tr>
        <% cart.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td>₹<%= item.price %></td>
            <td><%= item.quantity %></td>
            <td>₹<%= item.price * item.quantity %></td>
            <td>
              <form action="/cart/remove/<%= item.productId %>" method="POST">
                <button type="submit">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
      <h3>Total: ₹<%= total %></h3>
      <a href="/checkout" class="btn">Proceed to Payment</a>
    <% } %>
  </div>
</body>
</html>